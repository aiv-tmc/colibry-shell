# NixOS module for Colibry.
#
# Enables a Colibry Wayland session and materializes the TOML system
# configuration at /etc/colibry/colibry.toml.
{ config, lib, pkgs, ... }:

let
  cfg = config.services.colibry;

  # Renders the monitors array for the TOML file.
  monitorsToml = if cfg.monitors == [] then "[]" else
    "[ " + lib.concatStringsSep ", " (map (m: "\"${m}\"") cfg.monitors) + " ]";

  configToml = ''
    # Colibry system configuration (generated by the NixOS module)
    wallpaper = "${cfg.wallpaper}"
    cursor_theme = "${cfg.cursorTheme}"
    cursor_size = ${toString cfg.cursorSize}
    monitors = ${monitorsToml}
  '';
in
{
  options.services.colibry = {
    enable = lib.mkEnableOption "the Colibry Wayland compositor session";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.colibry;
      defaultText = lib.literalExpression "pkgs.colibry";
      description = "The Colibry compositor package.";
    };

    wallpaper = lib.mkOption {
      type = lib.types.str;
      default = "${cfg.package}/share/colibry/wallpapers/default.png";
      defaultText = lib.literalExpression ''"''${cfg.package}/share/colibry/wallpapers/default.png"'';
      description = ''
        Absolute path of the wallpaper image (PNG or JPEG). The package
        ships the assets from the repository's assets/ directory; point
        this at one of them or at any image on the system.
      '';
    };

    cursorTheme = lib.mkOption {
      type = lib.types.str;
      default = "";
      example = "Adwaita";
      description = "XCursor theme name; empty selects the system default.";
    };

    cursorSize = lib.mkOption {
      type = lib.types.int;
      default = 24;
      description = "Cursor size in pixels.";
    };

    monitors = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      example = [ "eDP-1,1920x1200,1" ",preferred,1.5" ];
      description = ''
        Monitor rules as "name,resolution,scale" strings; an empty name
        matches every output. Resolution is "preferred" or "WxH".
      '';
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Extra lines appended to /etc/colibry/colibry.toml.";
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ cfg.package ];

    environment.etc."colibry/colibry.toml".text = configToml + cfg.extraConfig;

    services.logind.enable = true;
  };
}
